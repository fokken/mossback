{
  "$schema": "https://opencode.ai/config.json",
  "model": "mossback/__LLM_MODEL__",
  "default_agent": "static-analyst",
  "autoupdate": false,
  "share": "disabled",
  "enabled_providers": [
    "mossback"
  ],
  "mcp": {
    "burp": {
      "type": "local",
      "command": [
        "java",
        "-jar",
        "/opt/burp/mcp-proxy-all.jar",
        "--sse-url",
        "http://127.0.0.1:9876"
      ],
      "enabled": false,
      "timeout": 120000
    },
    "pyghidra": {
      "type": "local",
      "command": [
        "/opt/pyghidra-mcp/bin/pyghidra-mcp",
        "--transport",
        "stdio",
        "--project-path",
        "/audit/work/ghidra-projects"
      ],
      "enabled": true,
      "timeout": 600000
    },
    "wiremcp": {
      "type": "local",
      "command": [
        "node",
        "/opt/wiremcp/index.js"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
  "permission": {
    "*": "deny",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "bash": "deny",
    "task": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": {
      "*": "deny",
      "/audit/input/**": "allow",
      "/audit/output/**": "allow",
      "/audit/rules/**": "allow",
      "/opt/mossback/**": "allow",
      "/opt/semgrep-rules/**": "allow"
    },
    "edit": {
      "*": "deny",
      "/audit/work/**": "allow",
      "/audit/output/**": "allow",
      "/audit/work/AGENTS.md": "deny",
      "/audit/work/.config/**": "deny"
    },
    "pyghidra_*": "deny",
    "wiremcp_*": "deny",
    "burp_*": "deny",
    "burp_get_proxy_http_history": "allow",
    "burp_get_proxy_http_history_regex": "allow",
    "burp_get_proxy_websocket_history": "allow",
    "burp_get_proxy_websocket_history_regex": "allow",
    "burp_get_scanner_issues": "allow",
    "burp_get_organizer_items": "allow",
    "burp_get_organizer_items_regex": "allow"
  },
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  },
  "provider": {
    "mossback": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Configured LLM through restricted proxy",
      "options": {
        "baseURL": "{env:LLM_BASE_URL}",
        "apiKey": "proxy-managed"
      },
      "models": {
        "__LLM_MODEL__": {
          "name": "Configured model",
          "id": "__LLM_MODEL__",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  }
}
