# Operator settings: export these in your shell; the launcher does not source this file.
LLM_HOST=192.168.1.50
LLM_PORT=8080
LLM_MODEL=your-model
LLM_TLS=0
LLM_ALLOW_PUBLIC=0
LLM_API_STYLE=openai-compatible
# Public HTTPS API: explicitly set LLM_ALLOW_PUBLIC=1, LLM_TLS=1,
# LLM_HOST=provider.example.com and LLM_PORT=443. See docs/llm-providers.md.
# For OpenAI's Responses API use LLM_API_STYLE=openai.
ANALYSIS_SUBNET=10.203.0.0/29
# AUDIT_LOG_DIR=/absolute/path/operator-audit
# ANALYSIS_RULES_DIR=/absolute/path/assessment-rules
# LLM_API_KEY is optional; supply it privately, never commit it.

# Reviewed immutable build inputs; replace all placeholder values.
BASE_IMAGE=docker.io/kalilinux/kali-rolling@sha256:REPLACE
PROXY_BASE_IMAGE=docker.io/library/debian:bookworm-slim@sha256:REPLACE
OPENCODE_VERSION=REPLACE
SEMGREP_VERSION=REPLACE
CHECKOV_VERSION=REPLACE
SEMGREP_RULES_COMMIT=REPLACE_WITH_40_CHARACTER_COMMIT
WIREMCP_COMMIT=REPLACE_WITH_40_CHARACTER_COMMIT
CODEQL_BUNDLE_TAG=codeql-bundle-vREPLACE
CODEQL_BUNDLE_SHA256=REPLACE_WITH_64_CHARACTER_CHECKSUM
