{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://security-ai.local/schemas/finding.schema.json",
  "title": "Security analysis finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "asset", "evidence", "confidence", "severity", "verification_status", "discovered_by", "recommendation"],
  "properties": {
    "id": { "type": "string", "pattern": "^F-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string" },
    "asset": { "type": "string", "minLength": 1 },
    "location": { "type": "string" },
    "category": { "type": "string" },
    "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
    "hypothesis": { "type": "string" },
    "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^E-[A-Z0-9-]+$" } },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "severity": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] },
    "impact": { "type": "string" },
    "exploitability": { "type": "string" },
    "verification_status": { "type": "string", "enum": ["unverified", "investigating", "confirmed", "rejected", "needs_manual_review"] },
    "discovered_by": { "type": "string", "minLength": 1 },
    "related_findings": { "type": "array", "items": { "type": "string", "pattern": "^F-[A-Z0-9-]+$" } },
    "recommendation": { "type": "string", "minLength": 1 }
  }
}
